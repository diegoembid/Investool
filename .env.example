# Copia este fichero como .env y rellénalo. El fichero .env NUNCA se sube a GitHub.
# Los valores que empiezan por CAMBIAR se generan con:
#   docker compose run --rm --no-deps backend python -m app.cli generate-secret

# --- Seguridad (obligatorio) ---
APP_SECRET_KEY=CAMBIAR-genera-una-clave
POSTGRES_PASSWORD=CAMBIAR-genera-una-contraseña

# En tu ordenador (http://localhost) debe ser false. En el servidor con HTTPS, true.
COOKIE_SECURE=false
ENVIRONMENT=local
# Nombres con los que se abre la aplicación. En el servidor se añadirá su dominio.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Claves de IA (copiarlas desde el gestor de contraseñas) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Topes de gasto de IA, en USD por mes natural (hora UTC) ---
# Deben ser iguales o menores que los límites puestos en la consola de cada proveedor.
AI_ENABLED=true
AI_ANTHROPIC_MONTHLY_CAP_USD=80
AI_OPENAI_MONTHLY_CAP_USD=40
AI_GLOBAL_MONTHLY_CAP_USD=120
AI_GLOBAL_DAILY_CAP_USD=10

# Solo para mostrar importes aproximados en euros.
USD_TO_EUR=0.86

# Modelos baratos usados en la prueba de conexión.
AI_ANTHROPIC_SMOKE_MODEL=claude-haiku-5-5
AI_OPENAI_SMOKE_MODEL=gpt-6-luna
